[Unit]
Description=OmniHub Smart Display Kiosk for Microsoft Surface Go 2
After=network.target sound.target graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
User=%I
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/%I/.Xauthority
WorkingDirectory=/home/calvn/.gemini/antigravity/scratch/omnihub
ExecStart=/bin/bash /home/calvn/.gemini/antigravity/scratch/omnihub/scripts/start.sh
Restart=always
RestartSec=5
KillMode=process

[Install]
WantedBy=graphical-session.target
