[Unit]
Description=OmniHub Smart Display Kiosk for Microsoft Surface Go 2
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/habhub
ExecStart=%h/habhub/scripts/start.sh
Restart=always
RestartSec=5
KillMode=process

[Install]
WantedBy=graphical-session.target
